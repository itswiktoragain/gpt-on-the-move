@@ -0,0 +1,39 @@
+import com.minecraftjogger.touch.TextInputProbe;
+import java.util.Properties;
+public class TextInputTapTest {
+    public static class Screen {
+        public int width=400,height=200;
+        public EditBox focused=new EditBox(100,80,180,22);
+        public EditBox getFocused(){return focused;}
+    }
+    public static class EditBox {
+        public int x,y,width,height;
+        EditBox(int xx,int yy,int w,int h){x=xx;y=yy;width=w;height=h;}
+        public boolean isFocused(){return true;}
+    }
+    public static class ChatScreen extends Screen{}
+    private static int checks;
+    private static void check(boolean condition,String message){checks++;if(!condition)throw new AssertionError(message);}
+    public static void main(String[] args){
+        Properties props=new Properties();Screen screen=new Screen();
+        TextInputProbe.observe(screen,"SCREEN",props);
+        check(!TextInputProbe.state().active,"focused field alone does NOT open keyboard");
+        TextInputProbe.request(.06f,.06f);TextInputProbe.observe(screen,"SCREEN",props);
+        check(!TextInputProbe.state().active,"tapping outside field keeps it hidden");
+        TextInputProbe.request(.5f,.45f);TextInputProbe.observe(screen,"SCREEN",props);
+        check(TextInputProbe.state().active,"tapping inside field opens it");
+        screen.focused=new EditBox(30,25,100,20);TextInputProbe.observe(screen,"SCREEN",props);
+        check(!TextInputProbe.state().active,"changing focus closes keyboard");
+        TextInputProbe.request(.2f,.16f);TextInputProbe.observe(screen,"SCREEN",props);
+        check(TextInputProbe.state().active,"new field tap reopens keyboard");
+        ChatScreen chat=new ChatScreen();TextInputProbe.observe(chat,"CHAT",props);
+        check(!TextInputProbe.state().active,"entering chat never auto opens");
+        TextInputProbe.request(.5f,.2f);TextInputProbe.observe(chat,"CHAT",props);
+        check(!TextInputProbe.state().active,"tapping chat panel above input does not open");
+        TextInputProbe.request(.5f,.98f);TextInputProbe.observe(chat,"CHAT",props);
+        check(TextInputProbe.state().active,"tapping chat input opens");
+        TextInputProbe.observe(null,"PLAY",props);
+        check(!TextInputProbe.state().active,"gameplay closes keyboard");
+        System.out.println("Tap-only keyboard checks: "+checks);
+    }
+}
