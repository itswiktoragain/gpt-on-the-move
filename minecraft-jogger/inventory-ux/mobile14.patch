@@ -0,0 +1,52 @@
+package com.minecraftjogger.touch;
+import java.io.*;import java.util.*;import java.util.concurrent.Executor;
+public final class InventoryActionsTest {
+    enum ClickType {PICKUP,THROW}
+    static class ItemStack {int count;ItemStack(int n){count=n;}public int getCount(){return count;}}
+    static class Slot {public int slot;ItemStack stack;Slot(int id,int c){slot=id;stack=new ItemStack(c);}public ItemStack getItem(){return stack;}}
+    static class Screen {
+        public int width=400,height=200,leftPos=10,topPos=10;Slot left=new Slot(2,20),right=new Slot(3,0),last;
+        protected Slot getHoveredSlot(double x,double y){return x<60?left:x>240?right:null;}
+        protected void slotClicked(Slot slot,int id,int button,ClickType type){
+            if(type==ClickType.THROW){int take=button==1?slot.stack.count:1;slot.stack.count-=Math.min(take,slot.stack.count);return;}
+            if(type!=ClickType.PICKUP)throw new AssertionError();
+            if(button==0){if(last==null){last=new Slot(-999,slot.stack.count);slot.stack.count=0;}else{slot.stack.count+=last.stack.count;last=null;}}
+            else {if(last!=null&&last.stack.count>0){slot.stack.count++;last.stack.count--;}}
+        }
+    }
+    static class CreativeModeInventoryScreen extends Screen{}
+    static class SlotWrapper extends Slot{SlotWrapper(int id,int c){super(id,c);}}
+    static class Minecraft implements Executor {Screen screen;Minecraft(Screen s){screen=s;}public void execute(Runnable job){job.run();}}
+    private static void ok(boolean b,String text){if(!b)throw new AssertionError(text);}
+    private static BufferedWriter writer;
+    private static void prepare(Screen s){
+        Properties p=new Properties();
+        p.setProperty("class.creativeInventory",CreativeModeInventoryScreen.class.getName());
+        p.setProperty("class.creativeSlotWrapper",SlotWrapper.class.getName());
+        p.setProperty("method.inventory.hover","getHoveredSlot");p.setProperty("method.inventory.click","slotClicked");
+        p.setProperty("method.slot.item","getItem");p.setProperty("method.stack.count","getCount");
+        MobileHooks.names=p;MobileHooks.client=new Minecraft(s);MobileHooks.screenState="INVENTORY";
+        writer=new BufferedWriter(new StringWriter());MobileHooks.attach(writer);
+    }
+    public static void main(String[] args){
+        Screen s=new Screen();prepare(s);
+        InventoryActions.begin(5,10,.05f,.8f);
+        InventoryActions.transfer(5,10,.8f,.8f,7);
+        ok(s.left.stack.count==13&&s.right.stack.count==7,"partial seven into other slot");
+        s=new Screen();prepare(s);InventoryActions.begin(6,11,.05f,.8f);
+        InventoryActions.transfer(6,11,.8f,.8f,20);
+        ok(s.left.stack.count==0&&s.right.stack.count==20,"whole stack into other slot");
+        s=new Screen();prepare(s);InventoryActions.begin(7,12,.05f,.8f);
+        InventoryActions.transfer(7,12,.05f,.8f,5);
+        ok(s.left.stack.count==20,"same source ignored");
+        CreativeModeInventoryScreen c=new CreativeModeInventoryScreen();c.left=new SlotWrapper(4,20);prepare(c);
+        InventoryActions.begin(8,13,.05f,.8f);
+        InventoryActions.transfer(8,13,.25f,.3f,4);
+        ok(c.left.stack.count==16,"creative-grid drop throws exactly four");
+        c=new CreativeModeInventoryScreen();c.left=new SlotWrapper(4,20);prepare(c);
+        InventoryActions.begin(9,14,.05f,.8f);
+        InventoryActions.transfer(9,14,.25f,.3f,20);
+        ok(c.left.stack.count==0,"creative-grid drop throws whole stack");
+        System.out.println("Inventory adapter: partial/full/invalid/creative disposal checks passed");
+    }
+}
