new file mode 100644
--- /dev/null
+++ b/scripts/inventory-tests/GestureRegression.java
@@ -0,0 +1,40 @@
+import net.kdt.pojavlaunch.jogger.mobile.*;
+import java.io.*;
+import java.awt.image.*;
+import javax.imageio.ImageIO;
+public class GestureRegression {
+    private static int checks;
+    private static void yes(boolean value,String msg){checks++;if(!value)throw new AssertionError(msg);}
+    public static void main(String[] args)throws Exception {
+        yes(StackCharge.selected(64,0)==64,"short drag takes all");
+        yes(StackCharge.selected(64,999)==64,"999ms still takes all");
+        yes(StackCharge.fraction(1000)==0,"starts at 0 at 1000ms");
+        yes(StackCharge.selected(64,1500)==7,"10% of 64 = 7");
+        yes(StackCharge.selected(64,3500)==32,"50% of 64");
+        yes(StackCharge.selected(64,6000)==64,"100% after 1s+5s");
+        yes(StackCharge.selected(1,2000)==1,"never takes 0 from 1");
+        yes(StackCharge.selected(64,14000)==64,"caps at 100%");
+        yes(StackCharge.selected(0,7000)==0,"empty source stays empty");
+        yes(!KeyboardViewport.moveGame(1000,250,500),"top field may be covered");
+        yes(KeyboardViewport.moveGame(1000,250,900),"bottom field moves game viewport");
+        yes(!KeyboardViewport.moveGame(1000,0,900),"hidden keyboard has no pan");
+        BufferedImage image;
+        if(args.length>0)image=ImageIO.read(new File(args[0]));
+        else {
+            image=new BufferedImage(128,128,BufferedImage.TYPE_INT_ARGB);
+            for(int code:new int[]{'M','W','i','l'}){
+                int width=(code=='i'||code=='l')?2:6;
+                for(int y=0;y<7;y++)for(int x=0;x<width;x++)image.setRGB((code%16)*8+x,(code/16)*8+y,0xffffffff);
+            }
+        }
+        int[] pixels=image.getRGB(0,0,image.getWidth(),image.getHeight(),null,0,image.getWidth());
+        int[] widths=PixelGlyphMetrics.widths(pixels,image.getWidth(),image.getHeight());
+        yes(widths['i']<widths['M'],"i is narrower than M");
+        yes(widths['l']<widths['W'],"l is narrower than W");
+        yes(widths[' ']>0&&widths[' ']<widths['W'],"space is a narrow advance");
+        int[] offsets=PixelGlyphMetrics.positions("IllM",widths);String name="IllM";
+        for(int i=0;i<offsets.length-1;i++)yes(offsets[i]+widths[name.charAt(i)]<offsets[i+1],"glyphs never overlap");
+        yes(PixelGlyphMetrics.total("iii",widths)<PixelGlyphMetrics.total("WWW",widths),"proportional spacing");
+        System.out.println("Gesture/stack/pixel-font/viewport checks passed: "+checks);
+    }
+}
