@@ -0,0 +1,34 @@
+package net.kdt.pojavlaunch.jogger.mobile;
+
+/** Glyph widths measured from Minecraft's 16-by-16 ASCII atlas; no proportional-font guesses. */
+public final class PixelGlyphMetrics {
+    private PixelGlyphMetrics(){}
+    public static int[] widths(int[] pixels,int atlasWidth,int atlasHeight){
+        if(atlasWidth<=0||atlasHeight<=0||atlasWidth%16!=0||atlasHeight%16!=0||pixels.length<atlasWidth*atlasHeight)
+            throw new IllegalArgumentException("Invalid ASCII glyph atlas");
+        int[] result=new int[256];int cell=atlasWidth/16, rows=atlasHeight/16;
+        for(int c=0;c<256;c++){
+            int left=(c%16)*cell,top=(c/16)*rows,right=-1;
+            for(int y=0;y<rows;y++)for(int x=0;x<cell;x++)
+                if((pixels[(top+y)*atlasWidth+left+x]>>>24)!=0&&x>right)right=x;
+            // A blank space is narrower than a capital M, and always advances.
+            result[c]=c==32?Math.max(2,cell/2):Math.min(cell,Math.max(1,right+1));
+        }
+        return result;
+    }
+    public static int total(String text,int[] widths){
+        int total=0;
+        for(int i=0;i<text.length();i++){
+            int code=text.charAt(i);if(code>=widths.length)throw new IllegalArgumentException("Character missing from ASCII atlas");
+            total+=widths[code];if(i+1<text.length())total++;
+        }
+        return total;
+    }
+    public static int[] positions(String text,int[] widths){
+        int[] result=new int[text.length()];int advance=0;
+        for(int i=0;i<text.length();i++){
+            result[i]=advance;advance+=widths[text.charAt(i)]+1;
+        }
+        return result;
+    }
+}
