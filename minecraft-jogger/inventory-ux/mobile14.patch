+package net.kdt.pojavlaunch.jogger.mobile;
+
+/** The first second is a gesture grace period, followed by five seconds of charge. */
+public final class StackCharge {
+    public static final long GRACE_MS=1000, FULL_MS=5000;
+    private StackCharge(){}
+    public static boolean charged(long heldMs){return heldMs>=GRACE_MS;}
+    public static float fraction(long heldMs){return Math.max(0f,Math.min(1f,(heldMs-GRACE_MS)/(float)FULL_MS));}
+    public static int selected(int original,long heldMs){
+        if(original<=0)return 0;
+        if(!charged(heldMs))return original;
+        return Math.min(original,Math.max(1,(int)Math.ceil(original*fraction(heldMs))));
+    }
+}
