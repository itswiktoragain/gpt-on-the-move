@@ -0,0 +1,40 @@
+import com.minecraftjogger.touch.MobileTransformer;
+import net.kdt.pojavlaunch.jogger.mobile.MappingCatalog;
+import org.objectweb.asm.*;
+import org.objectweb.asm.tree.*;
+import org.objectweb.asm.tree.analysis.*;
+import java.io.*;
+import java.nio.file.*;
+import java.util.*;
+import java.util.zip.*;
+
+public class HudTransformValidation {
+    static int checks;
+    static void check(boolean ok,String label){if(!ok)throw new AssertionError(label);checks++;}
+    public static void main(String[] args)throws Exception {
+        Properties props;
+        try(Reader file=Files.newBufferedReader(Paths.get(args[1]))){props=MappingCatalog.parse(file);}
+        String[] ids={"health","armor","hearts","food","air","vehicle","experience","level"};
+        for(String id:ids){check(props.containsKey("method.hud."+id),"missing HUD method "+id);check(props.containsKey("desc.hud."+id),"missing descriptor "+id);}
+        check(props.containsKey("method.graphics.width"),"missing graphics width");
+        check(props.containsKey("method.graphics.height"),"missing graphics height");
+        String cls=props.getProperty("class.hud"); check(cls!=null,"missing hud class");
+        byte[] in;
+        try(ZipFile archive=new ZipFile(args[0]);InputStream stream=archive.getInputStream(archive.getEntry(cls.replace('.','/')+".class"))){ByteArrayOutputStream data=new ByteArrayOutputStream();byte[] buf=new byte[65536];int n;while((n=stream.read(buf))!=-1)data.write(buf,0,n);in=data.toByteArray();}
+        MobileTransformer transformer=new MobileTransformer(props);
+        byte[] patched=transformer.transform(null,cls.replace('.','/'),null,null,in);
+        check(patched!=null&&patched.length>in.length,"patched HUD class exists");
+        ClassNode oldNode=new ClassNode(),newNode=new ClassNode();new ClassReader(in).accept(oldNode,0);new ClassReader(patched).accept(newNode,0);
+        int wrappers=0,armorStatic=0;
+        for(MethodNode m:newNode.methods){
+            if(m.name.startsWith("jogger$original$"))wrappers++;
+            if(m.name.equals(props.getProperty("method.hud.armor"))&&m.desc.equals(props.getProperty("desc.hud.armor"))&&(m.access&Opcodes.ACC_STATIC)!=0)armorStatic++;
+            if((m.access&(Opcodes.ACC_ABSTRACT|Opcodes.ACC_NATIVE))==0)
+                try{new Analyzer<>(new BasicVerifier()).analyze(newNode.name,m);}
+                catch(AnalyzerException e){throw new AssertionError("Invalid transformed HUD method "+m.name+m.desc,e);}
+        }
+        check(wrappers>=8,"expected HUD wrappers, found "+wrappers);
+        check(armorStatic==1,"static renderArmor wrapper preserved");
+        System.out.println("HUD actual 1.21.4 bytecode: "+checks+" checks passed ("+wrappers+" wrapped methods)");
+    }
+}
