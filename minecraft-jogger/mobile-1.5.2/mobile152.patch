+import com.minecraftjogger.touch.HudLayout;
+public class HudLayoutTest {
+    private static int checks;
+    private static void eq(double value,double expected,String name){if(Math.abs(value-expected)>1e-5)throw new AssertionError(name+":"+value);checks++;}
+    public static void main(String[] args){
+        HudLayout.Shift h=HudLayout.shift(4,560,315);eq(h.x,0,"health X");eq(h.y,-259,"health Y");
+        eq(HudLayout.shift(5,560,315).x,-180,"left edge");
+        eq(HudLayout.shift(6,560,315).x,180,"right edge");
+        eq(HudLayout.shift(7,560,315).y,-259,"mount top");
+        eq(HudLayout.shift(8,560,315).y,-271,"xp top");
+        eq(HudLayout.shift(9,560,315).y,-242,"level under bar");
+        eq(HudLayout.shift(4,180,100).y,0,"small GUI fallback");
+        eq(HudLayout.shift(5,560,0).x,0,"missing height fallback");
+        System.out.println("HUD layout: "+checks+" checks passed");
+    }
+}
