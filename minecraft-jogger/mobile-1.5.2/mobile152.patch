@@ -0,0 +1,22 @@
+package com.minecraftjogger.touch;
+/** GUI-space offsets; game-provided hearts, absorption and bars remain authoritative. */
+public final class HudLayout {
+    public static final class Shift {
+        public final double x,y;
+        public Shift(double x,double y){this.x=x;this.y=y;}
+    }
+    private HudLayout(){}
+    public static Shift shift(int kind,int width,int height){
+        if(width<210||height<80)return new Shift(0,0); // Conservative fallback.
+        double edge=Math.max(0,width/2.0-100.0);
+        switch(kind){
+            case 4: return new Shift(0,-height+56); // Player health group to top.
+            case 5: return new Shift(-edge,0);       // Hearts/armour top-left.
+            case 6: return new Shift(edge,0);        // Hunger/air top-right.
+            case 7: return new Shift(edge,-height+56);// Mount/vehicle hearts.
+            case 8: return new Shift(0,-height+44); // XP bar at top centre.
+            case 9: return new Shift(0,-height+73); // Level below XP bar.
+            default:return new Shift(0,0);
+        }
+    }
+}
